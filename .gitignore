# This repository publishes only the installable KOReader plugin, its release
# workflow, and the public README. Everything else in this workspace is local
# development/reference material and must not be pushed.
/*

!/.gitignore
!/README.md
!/libby-dashboard.koplugin/
!/libby-dashboard.koplugin/**
!/.github/
!/.github/workflows/
!/.github/workflows/release.yml
